# Copy to server/.env and fill in your key. Do NOT commit server/.env
FEATHERLESS_API_KEY=sk-your-featherless-key
FEATHERLESS_MODEL=Qwen/Qwen2.5-7B-Instruct
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1

# SQLite persistence (accounts, connections, chat, events, payments survive restarts).
# Leave empty/disabling by setting to a blank value if you want in-memory only.
SPORTSPHERE_DB=./sportsphere.db

# Optional
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:4173
